# ===================================================================
# Ytal Tech Solutions & Services LLP - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials
# ===================================================================

# Flask Environment & Core Security
FLASK_APP=app.py
FLASK_DEBUG=false
SECRET_KEY=your-strong-random-production-secret-key
SESSION_COOKIE_SECURE=true
INIT_DB_ON_STARTUP=true

# Persistent Storage Root (Leave blank to use application directory, or set to external volume mount e.g. /mnt/ytaltech_data)
# STORAGE_ROOT=/mnt/ytaltech_data

# Database Configuration (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://username:password@hostname:5432/ytaltech_elearning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Outbound SMTP Mail Server (Secureserver / GoDaddy)
MAIL_SERVER=smtpout.secureserver.net
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USE_TLS=false
MAIL_USERNAME=contact@ytaltech.com
MAIL_PASSWORD=your_smtp_password_here
MAIL_DEFAULT_SENDER=Ytal Tech <contact@ytaltech.com>
MAIL_TIMEOUT=15
MAIL_ASYNC=true

# Google OAuth 2.0 Authentication (Optional - leave blank if using Email/Password only)
# To enable Google Sign-In, obtain credentials from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials (Create OAuth 2.0 Client ID)
# Authorized redirect URI: https://<your-domain>/elearning/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
