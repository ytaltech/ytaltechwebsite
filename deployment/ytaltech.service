# ==============================================================================
# Ytal Tech Solutions & Services LLP - Systemd Production Service Unit
# ==============================================================================
# Path:    /etc/systemd/system/ytaltech.service
# Command: systemctl daemon-reload
# Enable:  systemctl enable ytaltech
# Start:   systemctl start ytaltech
# Status:  systemctl status ytaltech
# ==============================================================================

[Unit]
Description=Ytal Tech E-Learning Gunicorn WSGI Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ytaltech

# Environment file with production database credentials, secrets, and SMTP settings
EnvironmentFile=/opt/ytaltech/.env

# Gunicorn execution command:
# - Run without --preload to guarantee distinct DB connection pools per worker process
# - 4 worker processes + 2 threads per worker (gthread)
# - Bound to port 5001 (port 5000 is reserved on this host)
# - 60s request timeout
ExecStart=/opt/ytaltech/venv/bin/gunicorn \
    --workers 4 \
    --threads 2 \
    --worker-class gthread \
    --bind 127.0.0.1:5001 \
    --timeout 60 \
    --access-logfile /var/log/ytaltech/access.log \
    --error-logfile /var/log/ytaltech/error.log \
    --capture-output \
    wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=always
RestartSec=5s

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
